{
  "name": "@videreproject/constants",
  "version": "0.0.0-development",
  "type": "module",
  "description": "DB-generated domain enums and constants for Videre (formats, events, card attributes).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videre-project/platform.git",
    "directory": "packages/constants"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "^5.0.4"
  }
}
