{
  "name": "@videreproject/sql-schema",
  "version": "0.0.0-development",
  "type": "module",
  "description": "Generated database schema types and table references for Videre services.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videre-project/platform.git",
    "directory": "packages/sql-schema"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@videreproject/constants": "workspace:*",
    "@videreproject/sql-builder": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "^5.0.4"
  }
}
