{
  "name": "@videreproject/ui",
  "version": "0.0.0-development",
  "type": "module",
  "description": "Reusable Videre interface components, layouts, themes, and card-media contracts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videre-project/platform.git",
    "directory": "packages/ui"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dashboard-visuals": {
      "types": "./dist/components/dashboard/dashboard-visuals.d.ts",
      "import": "./dist/components/dashboard/dashboard-visuals.js",
      "default": "./dist/components/dashboard/dashboard-visuals.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js",
      "default": "./dist/fixtures/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "default": "./dist/tailwind-preset.js"
    },
    "./tooltip": {
      "types": "./dist/primitives/Tooltip.d.ts",
      "import": "./dist/primitives/Tooltip.js",
      "default": "./dist/primitives/Tooltip.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run typecheck && tsup && tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest --project storybook --run",
    "test:visual": "playwright test --config visual-tests/playwright.config.ts --project shared",
    "test:visual:update": "playwright test --config visual-tests/playwright.config.ts --project shared --update-snapshots"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.1.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@videreproject/constants": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.428.0",
    "react-day-picker": "^8.10.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.2.3",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@vitest/browser": "3.2.7",
    "storybook": "10.5.7",
    "tsup": "8.5.1",
    "vitest": "3.2.7"
  }
}
